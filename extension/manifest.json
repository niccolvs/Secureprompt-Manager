{
    "manifest_version": 3,
    "name": "SecurePrompt Censor",
    "version": "1.0",
    "description": "Censura datos sensibles antes de enviarlos a ChatGPT",
    "permissions": [
        "activeTab",
        "scripting"
    ],
    "host_permissions": [
        "http://127.0.0.1:8000/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": "icon.png"
    },
    "content_scripts": [
        {
            "matches": [
                "https://chatgpt.com/*",
                "https://chat.openai.com/*",
                "https://claude.ai/*",
                "https://gemini.google.com/*",
                "https://chat.deepseek.com/*",
                "https://manus.im/*"
            ],
            "js": [
                "content.js"
            ]
        }
    ]
}