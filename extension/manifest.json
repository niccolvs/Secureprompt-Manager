{
    "manifest_version": 3,
    "name": "SecurePrompt Manager",
    "key": "",
    "version": "1.0",
    "description": "Censura datos sensibles antes de enviarlos a ChatGPT",
    "permissions": [
        "activeTab",
        "scripting",
        "storage",
        "identity",
        "tabs"
    ],
    "oauth2": {
        "client_id": "1059291715077-j8fsb70pi3f2i07qcd4oh7dn485s0qis.apps.googleusercontent.com",
        "scopes": ["openid", "email", "profile"]
    },
    "host_permissions": [
        "http://127.0.0.1:8000/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "secureprompt@usm.cl",
            "strict_min_version": "109.0"
        }
    },
    "action": {
        "default_popup": "popup/popup.html",
        "default_icon": "assets/logo/SPM_logo_extension.png"
    },
    "content_scripts": [
        {
            "matches": [
                "https://chatgpt.com/*",
                "https://chat.openai.com/*",
                "https://claude.ai/*",
                "https://gemini.google.com/*",
                "https://chat.deepseek.com/*",
                "https://manus.im/*"
            ],
            "js": ["content.js"]
        }
    ],
    "web_accessible_resources": [
        {
            "resources": ["assets/logo/SPM_logo_extension.png"],
            "matches": [
                "https://chatgpt.com/*",
                "https://chat.openai.com/*",
                "https://claude.ai/*",
                "https://gemini.google.com/*",
                "https://chat.deepseek.com/*",
                "https://manus.im/*"
            ]
        }
    ]
}